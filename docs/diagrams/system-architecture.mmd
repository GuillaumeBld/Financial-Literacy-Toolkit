%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#8B0015', 'primaryTextColor': '#fff', 'primaryBorderColor': '#F1BE48', 'lineColor': '#333', 'secondaryColor': '#F1BE48', 'tertiaryColor': '#fff'}}}%%
flowchart TB
    subgraph Internet["Internet"]
        Users["Students & Instructors"]
    end

    subgraph Traefik["Traefik Reverse Proxy"]
        SSL["SSL/TLS Termination"]
        LB["Load Balancer"]
    end

    subgraph App["Next.js Application (2 Replicas)"]
        R1["Replica 1<br/>2GB RAM / 0.8 CPU"]
        R2["Replica 2<br/>2GB RAM / 0.8 CPU"]
    end

    subgraph Cache["Caching Layer"]
        L1["L1: In-Memory LRU<br/>(per-process)"]
        L2["L2: Redis<br/>(shared)"]
    end

    subgraph DB["Database Layer"]
        PG["PgBouncer<br/>600 client / 100 server"]
        Postgres["PostgreSQL 15<br/>Primary Data Store"]
    end

    Users --> SSL
    SSL --> LB
    LB --> R1
    LB --> R2
    R1 --> L1
    R2 --> L1
    L1 -.-> L2
    R1 --> PG
    R2 --> PG
    PG --> Postgres

    classDef primary fill:#8B0015,stroke:#F1BE48,color:#fff
    classDef secondary fill:#F1BE48,stroke:#8B0015,color:#333
    classDef neutral fill:#f5f5f5,stroke:#333,color:#333

    class Users,SSL,LB primary
    class R1,R2 secondary
    class L1,L2,PG,Postgres neutral
